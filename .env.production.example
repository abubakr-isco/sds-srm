# Copy to .env.production on the server and fill in. Never commit the real file.

# Database password: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_USER=sds
POSTGRES_DB=sds_crm

# Token signing key, at least 32 characters: openssl rand -base64 48
JWT_SECRET=

# Business calendar used for delivery-date checks.
COMPANY_TIMEZONE=America/Chicago

# Host port for the web container. Point your HTTPS proxy at it.
WEB_PORT=8080
