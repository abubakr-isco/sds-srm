# Copy to .env and adjust. Never commit real secrets.
NODE_ENV=development
PORT=3000

# PostgreSQL (docker-compose.yml starts one on localhost:5432)
DATABASE_URL=postgresql://sds:sds_local_password@localhost:5432/sds_crm?schema=public

# At least 32 random characters, e.g. `openssl rand -base64 48`. REQUIRED.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated origins allowed to call the API from a browser (only needed when
# the frontend is served from another origin; the Vite dev proxy is same-origin).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to true behind one reverse proxy (nginx, load balancer), or to the number of proxies in
# front of the API, so rate limits see real client IPs.
TRUST_PROXY=false

# Business calendar: "today" for dispatcher delivery-date checks.
COMPANY_TIMEZONE=America/Chicago

# Brute-force protection: lock an account after N failed logins for M minutes.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Per-IP limit for /api/auth/* (requests per minute)
AUTH_RATE_LIMIT_PER_MINUTE=20
# Per-IP limit for every other API route (requests per minute)
API_RATE_LIMIT_PER_MINUTE=600

# Settings → "Fill test data" (POST /api/dev/test-data). Always disabled when NODE_ENV=production.
ENABLE_TEST_DATA=true
# Password for test dispatchers created by "Fill test data" and by the seed.
TEST_DATA_PASSWORD=Test2026!

# Development seed accounts (npm run db:seed). The seed refuses to run when NODE_ENV=production.
SEED_ADMIN_EMAIL=admin@sds.local
SEED_ADMIN_PASSWORD=Admin2026!
SEED_DISPATCHER_EMAIL=dispatcher@sds.local
SEED_DISPATCHER_PASSWORD=Dispatch2026!
